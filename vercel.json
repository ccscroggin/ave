{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/review",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{content/companion/**,content/readings/**,site/aloud.js,site/i18n.js}",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/voice-sunday",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/voice-sunday",
      "schedule": "30 4 * * 0"
    }
  ]
}
